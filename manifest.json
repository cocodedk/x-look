{
  "manifest_version": 3,
  "name": "X Look — Reading Mode",
  "version": "1.1.0",
  "description": "Turns x.com into a quiet, work-friendly reading list: no left nav, no trends, calmer timeline.",
  "homepage_url": "https://xlook.cocode.dk",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Look: click to switch off or on"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["x-look.css"],
      "js": ["x-look.js"],
      "run_at": "document_idle"
    }
  ]
}

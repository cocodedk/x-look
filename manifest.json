{
  "manifest_version": 3,
  "name": "X Look \u2014 Reading Mode",
  "version": "1.1.0",
  "description": "Turns x.com into a quiet, work-friendly reading list: no left nav, no trends, calmer timeline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "x-look.css"
      ],
      "js": [
        "x-look.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
